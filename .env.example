# GeneGauge - example environment file.
# Copy to `.env` for local runs. `.env` itself is git-ignored.

# Bind address / port for local dev
GENEGAUGE_HOST=127.0.0.1
GENEGAUGE_PORT=8000

# "development" enables debug toolbar style reload; "production" tightens defaults.
GENEGAUGE_ENV=development

# Path to the weights CSV (relative paths are resolved against project root).
GENEGAUGE_WEIGHTS_PATH=data/weights.csv

# Size of the simulated reference population used for percentile comparison.
# Kept small by default so the app stays snappy on modest machines.
GENEGAUGE_POPULATION_SIZE=2000

# Deterministic seed for the simulated population. Change to re-shuffle.
GENEGAUGE_RANDOM_SEED=42

# Comma-separated list of trusted hosts. Use "*" only for local testing.
GENEGAUGE_ALLOWED_HOSTS=127.0.0.1,localhost

# Max JSON body size in bytes. Requests larger than this are rejected before parsing.
GENEGAUGE_MAX_BODY_BYTES=32768
