# =============================================================================
# GeneGauge PGC — environment configuration
# Copy to `.env` (backend) and `frontend/.env.local` (frontend) as needed.
# The app runs fully in DEMO MODE with none of these set.
# =============================================================================

# --- Backend: data mode ------------------------------------------------------
# Force bundled mock data ("1"/"true") or live loading ("0"/"false").
# If unset, demo mode is auto-enabled whenever HF_TOKEN is absent.
GENEGAUGE_DEMO_MODE=1

# Override bundled data dir / analysis-history store path (optional).
# GENEGAUGE_DATA_DIR=./backend/data
# GENEGAUGE_STORE_PATH=./backend/data/analyses_store.json

# --- Hugging Face (optional; enables live dataset loading) -------------------
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx
# HF_HOME=./.hf_cache

# --- Supabase (optional; JSON store used by default) -------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-service-or-anon-key

# --- Frontend ----------------------------------------------------------------
# Base URL of the FastAPI backend (used by the Next.js app).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
